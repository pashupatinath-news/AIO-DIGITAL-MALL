rules_version = '2';

service firebase.storage {

  match /b/{bucket}/o {

    // ================================================
    // PUBLIC PRODUCT / SHOP IMAGES
    // ================================================

    match /products/{allPaths=**} {

      allow read:
        if true;

      allow write:
        if request.auth != null;
    }

    match /shops/{allPaths=**} {

      allow read:
        if true;

      allow write:
        if request.auth != null;
    }

    match /banners/{allPaths=**} {

      allow read:
        if true;

      allow write:
        if request.auth != null;
    }

    // ================================================
    // USER FILES
    // ================================================

    match /users/{userId}/{allPaths=**} {

      allow read, write:
        if request.auth != null
        && request.auth.uid == userId;
    }

    // ================================================
    // TEAM FILES
    // ================================================

    match /team/{allPaths=**} {

      allow read, write:
        if request.auth != null;
    }

    // ================================================
    // DEFAULT DENY
    // ================================================

    match /{allPaths=**} {

      allow read, write:
        if false;
    }

  }

}